# Kommunradar på Simply.com
# Upphandlingsdatan uppdateras varje morgon och config.js ändras ibland — låt webbläsare alltid hämta senaste versionen.
<FilesMatch "^(leads\.json|config\.js)$">
  Header set Cache-Control "no-cache"
</FilesMatch>
# Den interna vyn ska inte publiceras.
<Files "radar.html">
  Require all denied
</Files>
# Tvinga https NÄR SSL-certifikatet är aktivt i Simply.com (ta bort # på de tre raderna nedan):
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
